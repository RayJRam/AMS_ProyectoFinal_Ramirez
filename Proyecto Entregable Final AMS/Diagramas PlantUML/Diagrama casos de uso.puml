@startuml
left to right direction

actor "Estudiante" as user
actor "Administrador" as admin

rectangle "Plataforma Web de Aprendizaje IAG" {
    usecase "Autenticarse en plataforma" as UC1
    usecase "Consultar Módulos y Lecciones" as UC2
    usecase "Realizar Evaluación de Módulo" as UC3
    usecase "Visualizar Progreso" as UC4
    usecase "Descargar Constancia" as UC5
    usecase "Gestionar Contenidos y Preguntas" as UC6
}

user --> UC1
user --> UC2
user --> UC3
user --> UC4
user --> UC5

admin --> UC1
admin --> UC6

UC3 .> UC2 : <<include>>
UC5 .> UC4 : <<extend>>
@enduml